{
  "name": "automation_test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "reset": "node database-tools/reset-db.js",
    "seed": "node database-tools/seed-db.js",
    "clean": "if exist allure-results (rd /s /q allure-results) && if exist allure-report (rd /s /q allure-report)",
    "test": "npx playwright test --reporter=list,allure-playwright",
    "test-ui": "npx playwright test --ui",
    "test:ui": "npx playwright test --ui",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "report": "npx allure serve allure-results",
    "full-test": "npm run clean && npm run test & npm run report"
  },
